# ----------------------------------------------------------------------
# KALPANA GOLD BUYERS PRIVATE LTD. - ENTERPRISE SECURITY & PERFORMANCE
# Fully Hardened Apache / LiteSpeed Configuration (OWASP & Lighthouse Compliant)
# ----------------------------------------------------------------------

# 1. DISABLE DIRECTORY BROWSING (Prevents Information Disclosure)
<IfModule mod_autoindex.c>
  IndexIgnore *
  Options -Indexes
</IfModule>

# 2. BLOCK ACCESS TO HIDDEN AND SENSITIVE FILES (Exempting RFC 8615 .well-known for MCP & Agents)
<FilesMatch "^\.(?!well-known)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<FilesMatch "(^#.*#|\.(bak|conf|dist|fla|in[ci]|log|psd|sh|sql|sw[op]|env|hintrc)|package\.json|package-lock\.json|README\.md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# 3. REWRITE ENGINE (HTTPS ENFORCEMENT & AGENT MARKDOWN CONTENT NEGOTIATION)
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Exempt RFC 8615 .well-known from rewrite rules
  RewriteRule ^\.well-known/ - [L]

  # Automatic HTTPS Enforcement
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Content Negotiation: Serve index.md when agent requests text/markdown on root or index.html
  RewriteCond %{HTTP:Accept} text/markdown [NC]
  RewriteCond %{REQUEST_URI} ^/(index\.html)?$ [NC]
  RewriteRule ^.*$ /index.md [L]
</IfModule>

# 4. HTTP SECURITY & CACHE HEADERS (CWE & OWASP Compliance)
<IfModule mod_headers.c>
  # HTTP Strict Transport Security (HSTS - RFC 6797 compliant, HTTPS only)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS

  # RFC 8288 Link Headers Advertising llms.txt and Markdown representation to Agents
  Header always set Link "</llms.txt>; rel=\"describedby\"; type=\"text/plain\", </index.md>; rel=\"alternate\"; type=\"text/markdown\""

  # Cross-Origin Resource Sharing (CORS) for Agent Context & MCP Server Card
  <FilesMatch "(server-card\.json|llms\.txt|index\.md)$">
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, OPTIONS"
    Header always set Access-Control-Allow-Headers "Accept, Content-Type"
  </FilesMatch>

  # Prevent MIME-type Sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Clickjacking Protection
  Header always set X-Frame-Options "SAMEORIGIN"

  # Referrer Policy
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Restrict Unnecessary Browser APIs
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"

  # Cross-Site Scripting (XSS) Protection
  Header always set X-XSS-Protection "1; mode=block"

  # Content Security Policy (CSP - Optimized for Google Fonts, Maps, & Cloudflare CDN)
  Header always set Content-Security-Policy "default-src 'self' 'unsafe-inline' https: data:; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com data:; img-src 'self' data: https:; frame-src 'self' https://www.google.com https://*.google.com https://maps.google.com;"

  # Performance Timing
  Header set Timing-Allow-Origin "*"

  # 1 Year Immutable Cache for Images & Fonts
  <FilesMatch "\.(ico|pdf|flv|jpg|jpeg|png|gif|webp|swf|woff|woff2|ttf|svg)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>

  # Revalidated Cache for Stylesheets & JavaScript (Ensures immediate updates)
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "max-age=86400, public, must-revalidate"
  </FilesMatch>

  # HTML Short Cache
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "max-age=3600, public, must-revalidate"
  </FilesMatch>
</IfModule>

# 5. ENABLE GZIP / DEFLATE COMPRESSION
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/ttf
  AddOutputFilterByType DEFLATE font/otf
  AddOutputFilterByType DEFLATE font/woff
  AddOutputFilterByType DEFLATE font/woff2
  AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
</IfModule>

# 6. BROWSER CACHING (EXPIRES HEADERS)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML documents
  ExpiresByType text/html "access plus 1 hour"

  # Stylesheets & JavaScript (Revalidated)
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType text/javascript "access plus 1 day"

  # Images
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Web Fonts
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

# 7. UTF-8 ENCODING & MIME TYPES
AddDefaultCharset UTF-8

<IfModule mod_mime.c>
  AddType text/markdown .md
  AddType application/json .json
  AddType text/plain .txt
  AddType application/xml .xml
</IfModule>
