{
  "extends": [
    "development"
  ],
  "hints": {
    "compat-api/css": "off",
    "no-inline-styles": "off",
    "compat-api/html": [
      "default",
      {
        "ignore": [
          "iframe[referrerpolicy=no-referrer-when-downgrade]"
        ]
      }
    ],
    "css-prefix-order": "off"
  },
  "browserslist": [
    "defaults",
    "not ie 11",
    "not and_ff <= 159",
    "not firefox <= 159",
    "not opera <= 135"
  ]
}